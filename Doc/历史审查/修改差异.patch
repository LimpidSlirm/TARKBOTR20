+"""Build real production units with only the hardware/RTOS interfaces replaced."""
+from pathlib import Path
+import json, os, re, subprocess
+
+ROOT=Path(__file__).resolve().parents[1]
+OUT=ROOT/'tests'/'.build'
+OUT.mkdir(exist_ok=True)
+STUBS=OUT/'include'
+STUBS.mkdir(exist_ok=True)
+header=(ROOT/'Robot/ax_robot.h').read_text(encoding='utf-8')
+for name in re.findall(r'#include "([^"]+)"',header):
+    if (ROOT/'Robot'/name).exists():continue
+    (STUBS/name).write_text('/* Host hardware interface; data structures remain in real ax_robot.h. */\n',encoding='utf-8')
+(STUBS/'ax_mpu6050.h').write_text('#include "../../../Driver/ax_mpu6050.h"\n',encoding='utf-8')
+source=(ROOT/'Robot/ax_robot.c').read_text(encoding='utf-8')
+def function(signature):
+    start=source.index(signature);end=source.index('{',start)+1;depth=1
+    while depth:
+        if source[end]=='{':depth+=1
+        if source[end]=='}':depth-=1
+        end+=1
+    return source[start:end]
+prefix=source[source.index('#define KEY_TURN_SPEED_MPS'):source.index('void Key_Turn_Scan_Task(')]
+(STUBS/'production_steps.inc').write_text(prefix+'\n'+function('static void Key_Turn_Test_Step(void)')+'\n'+function('void Robot_Task(void* parameter)'),encoding='utf-8')
+vswhere=Path(os.environ.get('ProgramFiles(x86)','C:/Program Files (x86)'))/'Microsoft Visual Studio/Installer/vswhere.exe'
+install=subprocess.check_output([str(vswhere),'-latest','-products','*','-requires','Microsoft.VisualStudio.Component.VC.Tools.x86.x64','-property','installationPath'],text=True).strip()
+vcvars=Path(install)/'VC/Auxiliary/Build/vcvars64.bat'
+units=['Robot/turn_control.c','Robot/ax_turn.c','Robot/ax_kinematics.c','Robot/ax_speed.c','Driver/ax_mpu6050.c','Driver/ax_encoder_extended.c','tests/test_competition.c']
+command='cl /nologo /utf-8 /W4 /WX /wd4244 /wd4100 /std:c11 /Od /RTC1 /fp:strict /DAPP_KEY_TURN_TEST=1 '
+command+=' /FIhost_platform.h '
+command+=' '.join('/I"'+os.path.relpath(p,OUT)+'"' for p in [STUBS,ROOT/'tests',ROOT/'Robot',ROOT/'Driver'])+' '
+command+=' '.join('"'+os.path.relpath(ROOT/u,OUT)+'"' for u in units)+' /Fe:test_competition.exe\n'
+batch=OUT/'compile.cmd'
